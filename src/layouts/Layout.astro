---
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import AdSense from '~/components/common/AdSense.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';
import { getLangFromUrl, getAlternateUrl, LANG_INFO, type Alternate } from '~/utils/i18n';

export interface Props {
  metadata?: MetaDataType;
  /** false: no AdSense script at all (no auto ads either). */
  ads?: boolean;
  /** Every language of this page, itself included (posts: findTranslations). Default: the tr/en twin. */
  alternates?: Alternate[];
}

const pageLang = getLangFromUrl(Astro.url);
const twin = getAlternateUrl(Astro.url);
const {
  metadata = {},
  ads = true,
  alternates = [
    { lang: pageLang, url: Astro.url.pathname },
    ...(twin ? [{ lang: pageLang === 'tr' ? 'en' : 'tr', url: twin }] : []),
  ],
} = Astro.props;
const textDirection = LANG_INFO[pageLang].dir;
const xDefault = alternates.find((a) => a.lang === 'en') ?? alternates.find((a) => a.lang === 'tr') ?? alternates[0];
---

<!doctype html>
<html lang={LANG_INFO[pageLang].htmlLang} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta ads={ads} />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} openGraph={{ locale: LANG_INFO[pageLang].og, ...metadata.openGraph }} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={LANG_INFO[a.lang].htmlLang} href={new URL(a.url, Astro.site).toString()} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(xDefault.url, Astro.site).toString()} />
    <SiteVerification />
    <Analytics />
    {ads && <AdSense />}

    <!-- RSS autodiscovery -->
    {
      pageLang !== 'tr' ? (
        <link rel="alternate" type="application/rss+xml" title="Hakan Çelik — Blog (EN)" href="/en/rss.xml" />
      ) : (
        <link rel="alternate" type="application/rss+xml" title="Hakan Çelik — Blog" href="/rss.xml" />
      )
    }

    <!-- Page-specific head elements (JSON-LD, article meta, etc.) -->
    <slot name="head" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <!-- Progress bar -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 w-0 h-1 bg-primary z-[9999] transition-all duration-150 ease-out"
    >
    </div>

    <slot />

    <BasicScripts />

    <script is:inline>
      document.addEventListener(
        'scroll',
        () => {
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          const progress = document.getElementById('scroll-progress');
          if (progress) {
            progress.style.width = scrolled + '%';
          }
        },
        { passive: true }
      );
    </script>
  </body>
</html>

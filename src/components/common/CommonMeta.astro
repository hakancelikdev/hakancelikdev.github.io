---
import { getAsset } from '~/utils/permalinks';

export interface Props {
  ads?: boolean;
}

const { ads = true } = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-adsense-account" content="ca-pub-2744131111608992" />
{
  ads && (
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2744131111608992"
      crossorigin="anonymous"
    />
  )
}

<link rel="sitemap" href={getAsset('/sitemap-index.xml')} />
